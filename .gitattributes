# Normalize text files to LF
* text=auto

# Git and editor configuration
.gitattributes text eol=lf
.editorconfig  text eol=lf

# Explicitly enforce LF for source and configuration
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.svg    text eol=lf
*.sh     text eol=lf

# Windows scripts
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary